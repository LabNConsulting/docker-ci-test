#!/bin/bash
set -ex

if [ "$DOCKER_TAG" == "latest" ]; then
    UVERSION=24.04
else
    UVERSION=${DOCKER_TAG}
    case $UVERSION in
        18.04)
            UNAME=bionic
            ;;
        18.10)
            UNAME=cosmic
            ;;
        19.04)
            UNAME=disco
            ;;
        19.10)
            UNAME=eoan
            ;;
        20.04)
            UNAME=focal
            ;;
        20.10)
            UNAME=groovy
            ;;
        21.04)
            UNAME=hirsute
            ;;
        21.10)
            UNAME=impish
            ;;
        22.04)
            UNAME=jammy
            ;;
        22.10)
            UNAME=kinetic
            ;;
        23.04)
            UNAME=lunar
            ;;
        23.10)
            UNAME=mantic
            ;;
        24.04)
            UNAME=noble
            ;;
        24.10)
            UNAME=oracular
            ;;
    esac
fi

_pl="df-pkglist-${UVERSION}"
if [ ! -f ${_pl} ]; then
    echo package list file ${_pl} missing - please define
    exit 1
fi

echo '# Do NOT edit this file; it is generated automatically' > $DOCKERFILE_PATH
cat df-pkglist-${UVERSION} df-Main >>$DOCKERFILE_PATH

docker build --build-arg UVERSION=$UVERSION --build-arg UNAME=$UNAME -f $DOCKERFILE_PATH -t $IMAGE_NAME .
