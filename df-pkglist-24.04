# -*- Dockerfile -*-
# List of packages needed for Ubuntu 24.04

#
# developer tools
#
ARG _PKGLIST_DEV="\
	autoconf \
        bash \
        bash-completion \
        bison \
        bridge-utils \
        build-essential \
        clang \
        cpio \
        curl \
        docker-ce \
        flex \
        gawk \
        gdb \
        gettext \
        git \
        gperf \
        iperf \
        iproute2 \
        iputils-ping \
        jq \
        kmod \
        libedit-dev \
        libev-dev \
        libffi-dev \
        libgmp-dev \
        libssl-dev \
        libxslt-dev \
        locales \
        locales-all \
        make \
        net-tools \
        netcat-openbsd \
        pciutils \
	pv \
        python3 \
        python3-cffi \
        python3-dev \
        python3-pip \
        python3-venv \
        rsync \
        snmp \
        ssh \
        systemd-coredump \
        sudo \
        tcpdump \
        tidy \
        traceroute \
        vim \
        xsltproc \
        zlib1g-dev"

#
# From VPP install-dep
#
ARG _PKGLIST_VPP="\
	autoconf \
	automake \
	build-essential \
	ccache \
        check \
	chrpath \
	clang \
	clang-format \
	clang-format-15 \
	clang-format-19 \
	cmake \
	cscope \
	curl \
	debhelper \
	dh-python \
	dkms \
	enchant-2 \
	ethtool \
	exuberant-ctags \
	gcovr \
	git \
	git-review \
	iperf \
	iperf3 \
	jq \
	lcov \
	libapr1-dev \
	libconfuse-dev \
	libelf-dev \
	libffi-dev \
	libffi8 \
	libmnl-dev \
	libnl-3-dev \
	libnl-route-3-dev \
	libnuma-dev \
	libpcap-dev \
	libssl-dev \
	libtool \
	libunwind-dev \
	llvm \
	meson \
	nasm \
	ninja-build \
	pkg-config \
	python3-all \
	python3-dev \
	python3-jsonschema \
	python3-pip \
	python3-ply \
	python3-setuptools \
	python3-venv \
	python3-virtualenv \
	python3-yaml \
	tshark"

#
# For FRR build
#
ARG _PKGLIST_FRR="\
        bison \
        flex \
        install-info \
        libc-ares-dev \
        libcap-dev \
        libjson-c-dev \
        libpam0g-dev \
        libprotobuf-c-dev \
        libreadline-dev \
        libsnmp-dev \
        libsystemd-dev \
        libzmq3-dev \
        libzmq5 \
        perl \
        protobuf-c-compiler \
        python3-attr \
        python3-pluggy \
        python3-py \
        python3-pytest \
        python3-sphinx \
        texinfo \
        # For libyang build
        libpcre3-dev \
        # For libyang and sysrepo
        libpcre2-dev"

#
# python packages formerly installed via pip3
# Missing: remarshal
#
ARG _PKGLIST_FORMERPIP="\
	docker-compose \
	pylint \
	tox \
	twine \
	python3-cffi \
	python3-coverage \
	python3-cryptography \
	python3-docker \
	python3-lxml \
	python3-nose \
	python3-pysnmp4 \
	python3-pytest \
	python3-scapy \
	python3-six \
	python3-wheel \
	python3-yaml"



ARG _PKGLIST="${_PKGLIST_DEV} ${_PKGLIST_VPP} ${_PKGLIST_FRR} ${_PKGLIST_FORMERPIP}"

ARG LIBYANGVERSION=2.1.148
ARG SYSREPOVERSION=2.2.150

